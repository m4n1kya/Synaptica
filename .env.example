# ============================================================================
# Synaptica — Environment Configuration
# Copy this file to .env and fill in your credentials before running locally.
# ============================================================================

# Google Gemini API Key (Required for live PDF fact extraction & linking)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Service Account JSON (Optional for local dev if firebase-adminsdk.json is present)
# In production (Render), paste the minified service account JSON string here:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
